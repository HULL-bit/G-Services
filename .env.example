# ============================================================================
#  G-SERVICES — variables d'environnement (copier vers .env puis adapter)
#      cp .env.example .env
# ============================================================================

# --- Base de données PostgreSQL ---
DB_NAME=gservices
DB_USER=gservices
DB_PASSWORD=change-me-in-production
DB_PORT=5432

# --- Application ---
APP_PORT=8080
# Development | Production  (Development = messages JSF détaillés, pas de cache Facelets)
FACES_PROJECT_STAGE=Production
# Thème PrimeFaces de base (saga | arya | vela | nova-light ...). Surchargé par theme.css.
PF_THEME=saga
SPRING_PROFILES_ACTIVE=docker

# --- pgAdmin ---  (email : éviter les TLD réservés type .local, pgAdmin les refuse)
PGADMIN_EMAIL=admin@gservices.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
